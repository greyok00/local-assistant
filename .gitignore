# Released archives, regenerated by product/scripts/build-release.mjs.
product/release/

# Browser profiles created by the demo harness. They hold cookies, wallet
# databases, and history; they must never enter the repository.
demo/build/*/
!demo/build/.gitignore

# Bench output and screenshots from demo runs.
demo/bench/results/*.json
test-results/

# Verification screenshots from the demo matrix, regenerated by
# demo/scripts/matrix-assistant.mjs; not committed.
demo/bench/shots/
